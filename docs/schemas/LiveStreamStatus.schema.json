{
  "$defs": {
    "LivePlatform": {
      "enum": [
        "TWITCH",
        "KICK",
        "YOUTUBE_LIVE",
        "CUSTOM_HLS"
      ],
      "title": "LivePlatform",
      "type": "string"
    },
    "LiveState": {
      "enum": [
        "STOPPED",
        "STARTING",
        "RUNNING",
        "PAUSED",
        "STOPPING",
        "ERROR"
      ],
      "title": "LiveState",
      "type": "string"
    },
    "LiveTailHealthMetrics": {
      "properties": {
        "fps": {
          "default": 0.0,
          "title": "Fps",
          "type": "number"
        },
        "chat_messages_per_sec": {
          "default": 0.0,
          "title": "Chat Messages Per Sec",
          "type": "number"
        },
        "buffer_latency_sec": {
          "default": 0.0,
          "title": "Buffer Latency Sec",
          "type": "number"
        },
        "dropped_frames": {
          "default": 0,
          "title": "Dropped Frames",
          "type": "integer"
        },
        "buffered_seconds": {
          "default": 0.0,
          "title": "Buffered Seconds",
          "type": "number"
        },
        "memory_mb": {
          "default": 0.0,
          "title": "Memory Mb",
          "type": "number"
        }
      },
      "title": "LiveTailHealthMetrics",
      "type": "object"
    }
  },
  "properties": {
    "stream_id": {
      "title": "Stream Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/LiveState",
      "default": "STOPPED"
    },
    "channel_name": {
      "title": "Channel Name",
      "type": "string"
    },
    "platform": {
      "$ref": "#/$defs/LivePlatform"
    },
    "uptime_sec": {
      "default": 0.0,
      "title": "Uptime Sec",
      "type": "number"
    },
    "total_bytes_ingested": {
      "default": 0,
      "title": "Total Bytes Ingested",
      "type": "integer"
    },
    "total_chat_messages": {
      "default": 0,
      "title": "Total Chat Messages",
      "type": "integer"
    },
    "active_subscribers": {
      "default": 0,
      "title": "Active Subscribers",
      "type": "integer"
    },
    "health": {
      "$ref": "#/$defs/LiveTailHealthMetrics"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    }
  },
  "required": [
    "stream_id",
    "channel_name",
    "platform"
  ],
  "title": "LiveStreamStatus",
  "type": "object"
}