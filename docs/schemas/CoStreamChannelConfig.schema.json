{
  "$defs": {
    "LivePlatform": {
      "enum": [
        "TWITCH",
        "KICK",
        "YOUTUBE_LIVE",
        "CUSTOM_HLS"
      ],
      "title": "LivePlatform",
      "type": "string"
    },
    "LiveStreamConfig": {
      "properties": {
        "channel_name": {
          "title": "Channel Name",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/LivePlatform",
          "default": "TWITCH"
        },
        "stream_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Url"
        },
        "buffer_duration_sec": {
          "default": 120.0,
          "description": "Depth of rolling video buffer",
          "title": "Buffer Duration Sec",
          "type": "number"
        },
        "microbatch_duration_sec": {
          "default": 10.0,
          "description": "Duration per micro-batch sliding window",
          "title": "Microbatch Duration Sec",
          "type": "number"
        },
        "ws_port": {
          "default": 8765,
          "title": "Ws Port",
          "type": "integer"
        },
        "sse_port": {
          "default": 8766,
          "title": "Sse Port",
          "type": "integer"
        },
        "anonymous_chat": {
          "default": true,
          "title": "Anonymous Chat",
          "type": "boolean"
        },
        "irc_nick": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irc Nick"
        },
        "irc_oauth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irc Oauth"
        },
        "max_replay_buffer_size": {
          "default": 250,
          "title": "Max Replay Buffer Size",
          "type": "integer"
        },
        "temp_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temp Dir"
        },
        "chatroom_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct Kick chatroom ID if known",
          "title": "Chatroom Id"
        },
        "youtube_api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional YouTube Data API v3 key",
          "title": "Youtube Api Key"
        },
        "custom_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Custom Headers",
          "type": "object"
        }
      },
      "required": [
        "channel_name"
      ],
      "title": "LiveStreamConfig",
      "type": "object"
    }
  },
  "properties": {
    "channel_id": {
      "title": "Channel Id",
      "type": "string"
    },
    "stream_config": {
      "$ref": "#/$defs/LiveStreamConfig"
    },
    "creator_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creator Name"
    },
    "is_reference_stream": {
      "default": false,
      "title": "Is Reference Stream",
      "type": "boolean"
    },
    "manual_latency_offset": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Latency Offset"
    },
    "max_buffer_size_mb": {
      "default": 250,
      "title": "Max Buffer Size Mb",
      "type": "integer"
    },
    "voiceprint_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voiceprint Profile Id"
    }
  },
  "required": [
    "channel_id",
    "stream_config"
  ],
  "title": "CoStreamChannelConfig",
  "type": "object"
}