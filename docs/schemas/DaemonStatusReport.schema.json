{
  "$defs": {
    "DaemonJobRecord": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "task_type": {
          "$ref": "#/$defs/DaemonTaskType"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "status": {
          "default": "PENDING",
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "duration_sec": {
          "default": 0.0,
          "title": "Duration Sec",
          "type": "number"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "task_type"
      ],
      "title": "DaemonJobRecord",
      "type": "object"
    },
    "DaemonState": {
      "enum": [
        "STOPPED",
        "STARTING",
        "RUNNING",
        "PAUSED",
        "DRAINING",
        "ERROR"
      ],
      "title": "DaemonState",
      "type": "string"
    },
    "DaemonTaskType": {
      "enum": [
        "CRAWL",
        "DOWNLOAD",
        "PIPELINE",
        "HOUSEKEEPING"
      ],
      "title": "DaemonTaskType",
      "type": "string"
    }
  },
  "properties": {
    "state": {
      "$ref": "#/$defs/DaemonState",
      "default": "STOPPED"
    },
    "pid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pid"
    },
    "uptime_seconds": {
      "default": 0.0,
      "title": "Uptime Seconds",
      "type": "number"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "last_crawl_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Crawl At"
    },
    "next_crawl_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Crawl At"
    },
    "active_downloads": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Active Downloads",
      "type": "array"
    },
    "active_pipeline_vod": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Pipeline Vod"
    },
    "queued_vods_count": {
      "default": 0,
      "title": "Queued Vods Count",
      "type": "integer"
    },
    "downloading_vods_count": {
      "default": 0,
      "title": "Downloading Vods Count",
      "type": "integer"
    },
    "harvested_vods_count": {
      "default": 0,
      "title": "Harvested Vods Count",
      "type": "integer"
    },
    "analyzed_vods_count": {
      "default": 0,
      "title": "Analyzed Vods Count",
      "type": "integer"
    },
    "error_vods_count": {
      "default": 0,
      "title": "Error Vods Count",
      "type": "integer"
    },
    "free_disk_gb": {
      "default": 0.0,
      "title": "Free Disk Gb",
      "type": "number"
    },
    "recent_errors": {
      "items": {
        "type": "string"
      },
      "title": "Recent Errors",
      "type": "array"
    },
    "recent_jobs": {
      "items": {
        "$ref": "#/$defs/DaemonJobRecord"
      },
      "title": "Recent Jobs",
      "type": "array"
    }
  },
  "title": "DaemonStatusReport",
  "type": "object"
}