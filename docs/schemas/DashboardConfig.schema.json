{
  "properties": {
    "host": {
      "default": "0.0.0.0",
      "description": "Host address to bind dashboard server",
      "title": "Host",
      "type": "string"
    },
    "port": {
      "default": 8000,
      "description": "HTTP port to bind dashboard server",
      "title": "Port",
      "type": "integer"
    },
    "reload": {
      "default": false,
      "description": "Enable auto-reload for development",
      "title": "Reload",
      "type": "boolean"
    },
    "homelab_root": {
      "default": "./homelab_storage",
      "description": "Root storage directory for VODs and artifacts",
      "title": "Homelab Root",
      "type": "string"
    },
    "catalog_db_url": {
      "default": "sqlite:///homelab_storage/catalog.db",
      "description": "Catalog database URL",
      "title": "Catalog Db Url",
      "type": "string"
    },
    "vector_db_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Vector database URL: postgresql://... for production pgvector, json://... for flat JSON, or sqlite://...",
      "title": "Vector Db Url"
    },
    "enable_cors": {
      "default": true,
      "description": "Enable Cross-Origin Resource Sharing",
      "title": "Enable Cors",
      "type": "boolean"
    },
    "cors_origins": {
      "description": "Allowed CORS origin list",
      "items": {
        "type": "string"
      },
      "title": "Cors Origins",
      "type": "array"
    },
    "static_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Custom path to static frontend assets",
      "title": "Static Dir"
    },
    "enable_auth": {
      "default": false,
      "description": "Enable basic API key header authentication",
      "title": "Enable Auth",
      "type": "boolean"
    },
    "api_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "API key when authentication is enabled",
      "title": "Api Key"
    },
    "postgres_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "PostgreSQL 17 connection string (e.g. postgresql://user:pass@192.168.1.100:5432/streamfusion)",
      "title": "Postgres Url"
    },
    "clickhouse_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ClickHouse HTTP/native endpoint (e.g. http://192.168.1.100:8123)",
      "title": "Clickhouse Url"
    },
    "qdrant_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Qdrant REST/gRPC endpoint (e.g. http://192.168.1.100:6333)",
      "title": "Qdrant Url"
    },
    "media_storage_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "NAS / SMB / Local filesystem mount for heavy video/audio blobs",
      "title": "Media Storage Path"
    }
  },
  "title": "DashboardConfig",
  "type": "object"
}