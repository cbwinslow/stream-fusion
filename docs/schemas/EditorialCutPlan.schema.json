    "CropLayout": {
      "enum": [
        "STACKED_CAM_CONTENT",
        "FULL_CONTENT_PAN_SCAN",
        "CAM_PIP"
      ],
      "title": "CropLayout",
      "type": "string"
    },
    "SubtitleStylePreset": {
      "enum": [
        "KARAOKE_POP",
        "CLEAN_MINIMAL",
        "MEME_EMOTE"
      ],
      "title": "SubtitleStylePreset",
      "type": "string"
    }
  },
  "properties": {
    "crop_layout": {
      "$ref": "#/$defs/CropLayout",
      "default": "STACKED_CAM_CONTENT"
    },
    "facecam_box": {
      "anyOf": [
        {
